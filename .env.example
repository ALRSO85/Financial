# Copy to .env and replace the placeholder with a cryptographically random key.
ASPIRE_DASHBOARD_OTLP_API_KEY=replace-with-random-32-byte-base64-key
ASPIRE_DASHBOARD_API_KEY=replace-with-a-different-random-32-byte-base64-key

# Keep loopback for local use. Set the observability host's private LAN address
# only when applications on another trusted machine must send telemetry.
OBSERVABILITY_BIND_ADDRESS=127.0.0.1

# Prometheus and Alertmanager UIs have no authentication by default. Keep them
# on loopback unless protected by an authenticated reverse proxy/firewall.
MONITORING_BIND_ADDRESS=127.0.0.1

# Use the host address that Docker containers can reach. If PostgreSQL ports
# are bound only to a LAN IP, set that address (for example 192.168.88.200).
MONITORING_HOST_ADDRESS=host-gateway

# Set unique random values before starting the optional `applications` profile.
FINANCIAL_JWT_SIGNING_KEY=replace-with-random-32-byte-or-longer-key
FINANCIAL_WRITE_DB_PASSWORD=replace-with-random-write-database-password
FINANCIAL_READ_DB_PASSWORD=replace-with-random-read-database-password
FINANCIAL_WRITE_MIGRATOR_DB_PASSWORD=replace-with-random-write-migrator-password
FINANCIAL_READ_MIGRATOR_DB_PASSWORD=replace-with-random-read-migrator-password

# Existing Docker network containing the two PostgreSQL containers.
FINANCIAL_DATABASE_NETWORK=financial-db_default

# Optional encrypted off-host backup. Leave empty until a destination and key
# have been provisioned. Use a named rclone remote, e.g. secure-store:finance/.
# The age recipient is public; never put the matching private identity here.
FINANCIAL_BACKUP_REMOTE_TARGET=
FINANCIAL_BACKUP_AGE_RECIPIENT=
# Plaintext backups are blocked by default. Set true only for an isolated,
# synthetic-data sandbox while encryption is not provisioned.
FINANCIAL_BACKUP_ALLOW_PLAINTEXT=false
# Optional path to a protected rclone config file; its credentials are secret.
RCLONE_CONFIG=
